<script>
  // Progressive enhancement: filters work only with JS
  const filters = document.querySelector('[data-filters]');
  const searchInput = document.querySelector('[data-search]') as HTMLInputElement;
  const regionSelect = document.querySelector('[data-region]') as HTMLSelectElement;
  const typeSelect = document.querySelector('[data-type]') as HTMLSelectElement;
  const starterCheck = document.querySelector('[data-starter]') as HTMLInputElement;
  const legendaryCheck = document.querySelector('[data-legendary]') as HTMLInputElement;
  const countEl = document.querySelector('[data-count]');
  const allCards = Array.from(document.querySelectorAll('[data-pokemon]')) as HTMLElement[];
  const allSections = Array.from(document.querySelectorAll('[data-region-section]')) as HTMLElement[];

  function applyFilters() {
    const searchTerm = searchInput.value.toLowerCase().trim();
    const selectedRegion = regionSelect.value;
    const selectedType = typeSelect.value;
    const starterOnly = starterCheck.checked;
    const legendaryOnly = legendaryCheck.checked;

    let visibleCount = 0;
    const visibleRegions = new Set<string>();

    allCards.forEach(card => {
      const name = card.dataset.name || '';
      const dex = card.dataset.dex || '';
      const types = (card.dataset.types || '').split(',');
      const region = card.dataset.region || '';
      const isStarter = card.dataset.starter === 'true';
      const isLegendary = card.dataset.legendary === 'true';

      const matchesSearch = !searchTerm || name.includes(searchTerm) || dex.includes(searchTerm);
      const matchesRegion = !selectedRegion || region === selectedRegion;
      const matchesType = !selectedType || types.includes(selectedType);
      const matchesStarter = !starterOnly || isStarter;
      const matchesLegendary = !legendaryOnly || isLegendary;

      const visible = matchesSearch && matchesRegion && matchesType && matchesStarter && matchesLegendary;

      if (visible) {
        card.removeAttribute('hidden');
        visibleCount++;
        visibleRegions.add(region);
      } else {
        card.setAttribute('hidden', '');
      }
    });

    // Hide empty region sections
    allSections.forEach(section => {
      const regionName = section.dataset.regionSection || '';
      if (visibleRegions.has(regionName)) {
        section.removeAttribute('hidden');
      } else {
        section.setAttribute('hidden', '');
      }
    });

    if (countEl) {
      countEl.textContent = `顯示 ${visibleCount} / ${allCards.length}`;
    }
  }

  if (searchInput) searchInput.addEventListener('input', applyFilters);
  if (regionSelect) regionSelect.addEventListener('change', applyFilters);
  if (typeSelect) typeSelect.addEventListener('change', applyFilters);
  if (starterCheck) starterCheck.addEventListener('change', applyFilters);
  if (legendaryCheck) legendaryCheck.addEventListener('change', applyFilters);
</script>

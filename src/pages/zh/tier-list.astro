  .tl-filter { display: flex; flex-direction: column; }
  .tl-count { margin: 0; font-weight: var(--font-semibold); color: var(--text-primary); }

  .tl-tabs { display: flex; gap: var(--space-2); border-bottom: 1px solid var(--border-base); margin-bottom: var(--space-md); }
  .tl-tab { background: none; border: 0; border-bottom: 3px solid transparent; padding: var(--space-2) var(--space-4); color: var(--text-tertiary); font: inherit; font-weight: var(--font-semibold); cursor: pointer; margin-bottom: -1px; }
  .tl-tab:hover { color: var(--text-primary); }
  .tl-tab[aria-selected='true'] { color: var(--accent-primary); border-bottom-color: var(--accent-primary); }
  .tl-panel[hidden] { display: none; }

  /* Classic tiermaker-style board: coloured label column + sprite row */
  .tl-rows { border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden; }
  .tl-row { display: grid; grid-template-columns: 4rem 1fr; border-top: 1px solid var(--border-subtle); }
  .tl-row:first-child { border-top: 0; }
  .tl-row-label { margin: 0; display: flex; align-items: center; justify-content: center; }
  .tl-row-s .tl-row-label { background: var(--tier-s); }
  .tl-row-a .tl-row-label { background: var(--tier-a); }
  .tl-row-b .tl-row-label { background: var(--tier-b); }
  .tl-row-c .tl-row-label { background: var(--tier-c); }
  .tl-row-label .tier-letter { background: transparent; font-size: var(--font-size-2xl); }
  .tl-row-cards { list-style: none; padding: var(--space-2); margin: 0; display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); background: var(--surface-elevated); }
  .tl-card { margin: 0; background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); }
  .tl-card[hidden] { display: none; }
  .tl-card-btn { width: 100%; display: grid; justify-items: center; gap: var(--space-1); padding: var(--space-2); background: none; border: 0; color: inherit; font: inherit; cursor: pointer; border-radius: inherit; }
  .tl-card-btn:hover { background: var(--surface-hover); }
  .tl-card-name { font-weight: var(--font-semibold); color: var(--text-primary); }
  .tl-card-move { font-size: var(--font-size-xs); color: var(--accent-primary); }
  .tl-card-note { font-size: var(--font-size-xs); color: var(--text-tertiary); margin: 0; padding: 0 var(--space-2) var(--space-2); text-align: center; line-height: var(--leading-snug); }
  .tl-empty { color: var(--text-tertiary); }

  .tl-dialog { max-width: 32rem; width: calc(100% - 2rem); background: var(--surface-card); color: var(--text-secondary); border: 1px solid var(--border-base); border-radius: var(--radius-lg); padding: var(--space-lg); }
  .tl-dialog::backdrop { background: rgb(0 0 0 / 0.7); }
  .tl-d-head { display: flex; gap: var(--space-md); align-items: center; margin-bottom: var(--space-md); }
  .tl-d-head h3 { margin: 0; }
  .tl-d-meta { margin: 0 0 var(--space-2); font-size: var(--font-size-sm); }
  .tl-d-bars { display: grid; gap: var(--space-2); margin: 0 0 var(--space-md); }
  .tl-d-bars div { display: grid; grid-template-columns: 4rem 1fr; align-items: center; gap: var(--space-2); }
  .tl-d-bars .stat-bar { display: block; }
  .tl-d-bars dd { margin: 0; display: grid; grid-template-columns: 1fr 3rem; gap: var(--space-2); align-items: center; }

  .tl-sort { background: none; border: 0; color: inherit; font: inherit; text-transform: inherit; letter-spacing: inherit; cursor: pointer; padding: 0; }
  .tl-sort::after { content: ' ↕'; color: var(--text-muted); }
  th[aria-sort='ascending'] .tl-sort::after { content: ' ↑'; color: var(--accent-primary); }
  th[aria-sort='descending'] .tl-sort::after { content: ' ↓'; color: var(--accent-primary); }

  @media (max-width: 640px) {
    .tl-row { grid-template-columns: 3rem 1fr; }
    .tl-row-cards { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
  }
</style>

<script>
  type Entry = {
    name: string; dex: number; tier: string; phase: string; types: string[]; hp: number; speed: number; atk: number;
    note: string; hpPct: number; speedPct: number; atkPct: number; move: string; moveLine: string; evo: string;
  };
  const $ = (id: string) => document.getElementById(id);

  // ---- Phase tabs (progressive enhancement: without JS all panels show) ----
  const tablist = document.querySelector<HTMLElement>('.tl-tabs');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tl-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.tl-panel'));
  const select = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const p = $(t.getAttribute('aria-controls') || '');
      if (p) p.hidden = !on;
    });
    if (focus) tab.focus();
    update();
  };
  if (tablist && tabs.length) {
    tablist.hidden = false;
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const map: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
        if (!(e.key in map)) return;
        e.preventDefault();
        select(tabs[(map[e.key] + tabs.length) % tabs.length], true);
      });
    });
    const fromHash = tabs.find((t) => `#${t.getAttribute('aria-controls')}` === location.hash);
    select(fromHash || tabs[0]);
  }

  // ---- Move filter + search with live count (counts the active phase) ----
  const filters = document.querySelector<HTMLElement>('.tl-filters');
  const moveSel = $('tl-move') as HTMLSelectElement | null;
  const search = $('tl-search') as HTMLInputElement | null;
  const count = $('tl-count');
  const empty = $('tl-empty');
  function update() {
    if (!moveSel || !search) return;
    const mv = moveSel.value;
    const q = search.value.trim().toLowerCase();
    const panel = panels.find((p) => !p.hidden) || panels[0];
    let shown = 0;
    let total = 0;
    panels.forEach((p) => p.querySelectorAll<HTMLElement>('.tl-card').forEach((c) => {
      const ok = (!mv || c.dataset.move === mv) && (!q || (c.dataset.name || '').includes(q));
      c.hidden = !ok;
      if (p === panel) { total++; if (ok) shown++; }
    }));
    panels.forEach((p) => p.querySelectorAll<HTMLElement>('.tl-row').forEach((r) => {
      r.hidden = !r.querySelector('.tl-card:not([hidden])');
    }));
    if (count) count.textContent = `顯示 ${shown} / ${total}`;
    if (empty) empty.hidden = shown > 0;
  }
  if (filters && moveSel && search) {
    filters.hidden = false;
    moveSel.addEventListener('change', update);
    search.addEventListener('input', update);
    update();
  }

  // ---- Detail dialog ----
  const dialog = $('tl-dialog') as HTMLDialogElement | null;
  const data: Record<string, Entry> = JSON.parse($('tl-data')?.textContent || '{}');
  const setText = (id: string, v: string) => { const el = $(id); if (el) el.textContent = v; };
  const setBar = (id: string, pct: number) => { $(id)?.style.setProperty('--value', String(pct)); };
  document.querySelectorAll<HTMLButtonElement>('.tl-card-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const d = data[btn.dataset.slug || ''];
      if (!d || !dialog || typeof dialog.showModal !== 'function') return;
      const img = $('tl-d-sprite') as HTMLImageElement | null;
      if (img) { img.src = `/sprites/${d.dex}.png`; img.alt = `${d.name} 精靈圖`; }
      setText('tl-d-name', d.name);
      setText('tl-d-meta', `${d.tier} 級，${d.phase}遊戲，#${String(d.dex).padStart(3, '0')}`);
      const types = $('tl-d-types');
      if (types) {
        types.replaceChildren(...d.types.map((t) => {
          const s = document.createElement('span');
          s.className = `badge badge-type type-${t}`;
          s.textContent = t.charAt(0).toUpperCase() + t.slice(1);
          return s;
        }));
      }
      setBar('tl-d-hpbar', d.hpPct); setText('tl-d-hp', String(d.hp));
      setBar('tl-d-spbar', d.speedPct); setText('tl-d-sp', String(d.speed));
      setBar('tl-d-atbar', d.atkPct); setText('tl-d-at', `×${d.atk.toFixed(2)}`);
      setText('tl-d-move', `${d.move}：${d.moveLine}`);
      setText('tl-d-evo', d.evo);
      setText('tl-d-why', d.note);
      dialog.showModal();
    });
  });

  // ---- Sortable stat table ----
  const table = $('tl-stats') as HTMLTableElement | null;
  table?.querySelectorAll<HTMLButtonElement>('.tl-sort').forEach((b) => {
    b.addEventListener('click', () => {
      const col = Number(b.dataset.col);
      const th = b.closest('th')!;
      const dir = th.getAttribute('aria-sort') === 'descending' ? 'ascending' : 'descending';
      table.querySelectorAll('th[aria-sort]').forEach((h) => h.setAttribute('aria-sort', 'none'));
      th.setAttribute('aria-sort', dir);
      const body = table.tBodies[0];
      const rows = Array.from(body.rows);
      const val = (r: HTMLTableRowElement) => Number((r.cells[col] as HTMLElement).dataset.v);
      rows.sort((a, z) => (dir === 'ascending' ? val(a) - val(z) : val(z) - val(a)));
      body.append(...rows);
    });
  });
</script>

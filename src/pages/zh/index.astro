      { name: 'Chimchar', dex: 390 }, { name: 'Tepig', dex: 498 }, { name: 'Fennekin', dex: 653 },
      { name: 'Litten', dex: 725 }, { name: 'Scorbunny', dex: 813 }, { name: 'Fuecoco', dex: 909 }
    ]

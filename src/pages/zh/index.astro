const faqItems = [
  {
    q: 'PokeSurvivor 有中文版嗎？',
    a: '沒有，介面只有英文與西班牙文。本站的 PokeSurvivor 攻略整理了<a href="#glossary">升級卡片中英對照表</a>，中文譯名是本站譯法，不是官方翻譯。',
  },

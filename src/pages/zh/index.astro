---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameEmbed from '../../components/GameEmbed.astro';
import FAQ from '../../components/FAQ.astro';
import Sprite from '../../components/Sprite.astro';
import TypeBadge from '../../components/TypeBadge.astro';

const title = 'PokeSurvivor 攻略｜寶可夢倖存者繁體中文新手指南：卡片對照、配隊推薦、強度排行與裂縫全解析';
const description = 'PokeSurvivor 攻略｜寶可夢倖存者繁體中文新手指南：免費瀏覽器即玩、29 隻初始夥伴、966 隻寶可夢、升級卡片中英對照、配隊推薦、強度排行與裂縫全解析，手機橫向支援。';
const timelineAlt = '一局流程時間軸示意圖：標出第 3 到 15 分鐘的 BOSS、1:15 起的神祕裂縫與第 30 分鐘登場的阿爾宙斯';

// Hero row: starters only (FACTS: 29 starters; Pikachu/Eevee are not starters).
const starterSprites = [
  { dex: 1, name: 'Bulbasaur' }, { dex: 4, name: 'Charmander' }, { dex: 7, name: 'Squirtle' },

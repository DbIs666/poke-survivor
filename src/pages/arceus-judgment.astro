    margin-bottom: var(--space-md);
  }

  ul {
    padding-left: 1.5rem;
    margin-bottom: var(--space-md);
  }

  li {
    margin-bottom: var(--space-2);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  a {
    color: var(--accent-primary);
  }

  a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }


---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Disclaimer | PokeSurvivor Fan Guide';
const description = 'Legal disclaimer for the unofficial PokéSurvivor fan guide. This is a non-commercial fan project with no official affiliation.';
---

<BaseLayout
  title={title}
  description={description}
  locale="en"
  canonical="/disclaimer/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Disclaimer', url: '/disclaimer/' },
  ]}
>
  <article class="content-article">
    <h1>Disclaimer</h1>
    <p class="updated-date">Last Updated: October 17, 2026</p>

    <section>
      <h2>Unofficial Fan Project</h2>
      <p>
        <strong>poke-survivors.org</strong> is an <strong>unofficial</strong>,
        non-commercial fan-created guide website. This site is <strong>not
        affiliated with, endorsed by, or sponsored by</strong>:
      </p>
      <ul>
        <li>The developer or publisher of the PokéSurvivor browser game</li>
        <li>Nintendo Co., Ltd.</li>
        <li>GAME FREAK inc.</li>
        <li>The Pokémon Company International, Inc.</li>
        <li>Creatures Inc.</li>
      </ul>
      <p>
        All trademarks, service marks, trade names, product names, and logos
        appearing on this site are the property of their respective owners.
      </p>
    </section>

    <section>
      <h2>Pokémon Copyright</h2>
      <p>
        Pokémon and Pokémon character names are trademarks of Nintendo, GAME
        FREAK, and The Pokémon Company. This fan guide exists to help players
        enjoy a free browser game inspired by Pokémon. We respect the rights
        of the trademark holders and make no claim to ownership of any Pokémon
        intellectual property.
      </p>
    </section>

    <section>
      <h2>PokéSurvivor Game</h2>
      <p>
        The official PokéSurvivor game is available at
        <a href="https://pokesurvivor.com/" rel="noopener"
          >pokesurvivor.com</a
        >. This website provides guides and information about that game but is
        not the official source. For official announcements, updates, and
        support, please visit the official game website.
      </p>
    </section>

    <section>
      <h2>Content Accuracy</h2>
      <p>
        We strive to provide accurate and up-to-date information, but this site
        is maintained by fans and may contain errors or outdated information.
        The PokéSurvivor game is actively developed and updated, so some guide
        content may become obsolete as the game evolves.
      </p>
      <p>
        <strong>Use this guide at your own discretion.</strong> We are not
        responsible for any consequences resulting from following advice or
        strategies presented on this site.
      </p>
    </section>

    <section>
      <h2>Sprite Attribution</h2>
      <p>
        Pokémon sprite graphics on this site are sourced from
        <a href="https://github.com/PMDCollab/SpriteCollab" rel="noopener"
          >PMD SpriteCollab</a
        >
        and are used under the
        <a
          href="https://creativecommons.org/licenses/by-nc/4.0/"
          rel="noopener license"
          >Creative Commons Attribution-NonCommercial 4.0 International
          License</a
        >
        (CC BY-NC 4.0). These sprites are fan-made artwork and are not official
        Pokémon assets.
      </p>
    </section>

    <section>
      <h2>External Links</h2>
      <p>
        This site contains links to external websites for reference and
        convenience. We are not responsible for the content, privacy practices,
        or availability of external sites. Visiting external links is at your
        own risk.
      </p>
    </section>

    <section>
      <h2>No Warranty</h2>
      <p>
        This website and its content are provided "as is" without warranty of
        any kind, express or implied. We make no representations or warranties
        regarding the accuracy, completeness, reliability, or availability of
        the site or its content.
      </p>
    </section>

    <section>
      <h2>Fair Use</h2>
      <p>
        This fan guide is created for informational and educational purposes.
        We believe our use of game information, screenshots, and related content
        constitutes fair use under applicable copyright law. If you are a rights
        holder and believe content on this site infringes your rights, please
        contact us so we can address your concerns.
      </p>
    </section>

    <section>
      <h2>Contact</h2>
      <p>
        For questions, concerns, or takedown requests related to this disclaimer,
        please contact us through the
        <a href="https://github.com/pokesurvivor-fan/poke-survivors.org" rel="noopener"
          >GitHub repository</a
        >
        for this project (if applicable) or other contact methods provided on
        this site.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .content-article {
    max-width: 70ch;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }

  .updated-date {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-top: -0.5rem;
    margin-bottom: var(--space-lg);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    margin-bottom: var(--space-sm);
  }

  h2 {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
    font-size: clamp(1.5rem, 4vw, 1.75rem);
  }

  section {
    margin-bottom: var(--space-lg);
  }

  p {
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  ul {
    margin: var(--space-md) 0;
    padding-left: var(--space-lg);
    line-height: 1.7;
  }

  li {
    margin-bottom: var(--space-sm);
  }

  a {
    color: var(--accent-primary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  a:hover {
    color: var(--accent-bright);
  }

  strong {
    font-weight: 600;
  }
</style>

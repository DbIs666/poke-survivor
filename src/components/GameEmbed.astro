---
interface Props {
  title?: string;
  height?: string;
  /** Use true on the homepage (above the fold). */
  eager?: boolean;
  /** Use 'link' to show a play button instead of embedding (bypasses iframe restrictions) */
  mode?: 'embed' | 'link';
}

const {
  title = 'PokéSurvivor official game (pokesurvivor.com)',
  height = 'auto',
  eager = false,
  mode = 'link',
} = Astro.props;
const GAME_URL = 'https://pokesurvivor.com/en/';
---

{mode === 'link' ? (
  <div class="game-link-card">
    <div class="card-content">
      <h3>Play PokéSurvivor</h3>
      <p>Experience the official game at pokesurvivor.com</p>
      <a href={GAME_URL} target="_blank" rel="noopener" class="play-button">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
        Play Now
      </a>
    </div>
  </div>
) : (
  <div class="game-embed">
    <div class="embed-container" style={height !== 'auto' ? `height: ${height}` : ''}>
      <div class="loading-indicator">
        <div class="spinner"></div>
        <p>Loading game...</p>
      </div>
      <iframe
        src={GAME_URL}
        title={title}
        allow="fullscreen; gamepad; autoplay"
        allowfullscreen
        loading={eager ? 'eager' : 'lazy'}
      >
        <a href={GAME_URL} rel="noopener">Play PokéSurvivor at pokesurvivor.com</a>
      </iframe>
      <noscript>
        <p class="noscript-fallback">The embedded game needs JavaScript. <a href={GAME_URL} rel="noopener">Play PokéSurvivor at pokesurvivor.com</a>.</p>
      </noscript>
    </div>
    <p class="game-link">
      <a href={GAME_URL} target="_blank" rel="noopener">
        Open in full window →
      </a>
    </p>
  </div>
)}

<style>
  /* Tokens come from src/styles/global.css (imported by BaseLayout). */

  /* Link mode styles */
  .game-link-card {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    background: var(--surface-base);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .card-content {
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .card-content h3 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2rem);
    color: var(--text-primary);
    font-weight: 700;
  }

  .card-content p {
    margin: 0;
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    color: var(--text-secondary);
  }

  .play-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.5rem;
    background: var(--accent-primary);
    color: #fff;
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    font-weight: 600;
    text-decoration: none;
    border-radius: 999px;
    transition: all 0.2s;
    box-shadow: 0 4px 12px rgba(56, 189, 248, 0.3);
  }

  .play-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(56, 189, 248, 0.4);
  }

  .play-button svg {
    width: 24px;
    height: 24px;
  }

  /* Embed mode styles */
  .game-embed {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .embed-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--surface-base);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-lg);
  }

  .loading-indicator {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--surface-base);
    z-index: 1;
    pointer-events: none;
  }

  .spinner {
    width: 48px;
    height: 48px;
    border: 4px solid var(--surface-elevated);
    border-top-color: var(--accent-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .loading-indicator p {
    margin: 0;
    color: var(--text-tertiary);
    font-size: clamp(0.875rem, 2vw, 1rem);
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: var(--surface-elevated);
  }

  .noscript-fallback {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 0.75rem 1rem;
    background: var(--surface-elevated);
    color: var(--text-primary);
    text-align: center;
  }

  iframe:not([src]) {
    display: none;
  }

  .game-link {
    margin: 1rem 0 0;
    text-align: center;
    font-size: clamp(0.875rem, 2vw, 0.9375rem);
  }

  .game-link a {
    color: var(--accent-primary);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .game-link a:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .embed-container {
      border-radius: 12px;
    }

    .game-link-card {
      border-radius: 12px;
    }

    .card-content {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const containers = document.querySelectorAll('.embed-container');

    containers.forEach(container => {
      const iframe = container.querySelector('iframe');
      const loading = container.querySelector<HTMLElement>('.loading-indicator');

      if (iframe && loading) {
        iframe.addEventListener('load', () => {
          loading.style.opacity = '0';
          loading.style.transition = 'opacity 0.3s';
          setTimeout(() => {
            loading.style.display = 'none';
          }, 300);
        });
      }
    });
  });
</script>

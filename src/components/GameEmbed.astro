---
interface Props {
  title?: string;
  height?: string;
  /** Use true on the homepage (above the fold). */
  eager?: boolean;
}

const {
  title = 'PokéSurvivor official game (pokesurvivor.com)',
  height = 'auto',
  eager = false,
} = Astro.props;
const GAME_URL = 'https://pokesurvivor.com/en/';
---

<div class="game-embed">
  <div class="embed-container" style={height !== 'auto' ? `height: ${height}` : ''}>
    <div class="loading-indicator">
      <div class="spinner"></div>
      <p>Loading game...</p>
    </div>
    <iframe
      src={GAME_URL}
      title={title}
      allow="fullscreen; gamepad; autoplay"
      allowfullscreen
      loading={eager ? 'eager' : 'lazy'}
    >
      <a href={GAME_URL} rel="noopener">Play PokéSurvivor at pokesurvivor.com</a>
    </iframe>
    <noscript>
      <p class="noscript-fallback">The embedded game needs JavaScript. <a href={GAME_URL} rel="noopener">Play PokéSurvivor at pokesurvivor.com</a>.</p>
    </noscript>
  </div>
  <p class="game-link">
    <a href={GAME_URL} target="_blank" rel="noopener">
      Open in full window →
    </a>
  </p>
</div>

<style>
  /* Tokens come from src/styles/global.css (imported by BaseLayout). */
  .game-embed {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .embed-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--surface-base);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-lg);
  }

  .loading-indicator {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--surface-base);
    z-index: 1;
    pointer-events: none;
  }

  .spinner {
    width: 48px;
    height: 48px;
    border: 4px solid var(--surface-elevated);
    border-top-color: var(--accent-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .loading-indicator p {
    margin: 0;
    color: var(--text-tertiary);
    font-size: clamp(0.875rem, 2vw, 1rem);
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: var(--surface-elevated);
  }

  .noscript-fallback {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 0.75rem 1rem;
    background: var(--surface-elevated);
    color: var(--text-primary);
    text-align: center;
  }

  iframe:not([src]) {
    display: none;
  }

  .game-link {
    margin: 1rem 0 0;
    text-align: center;
    font-size: clamp(0.875rem, 2vw, 0.9375rem);
  }

  .game-link a {
    color: var(--accent-primary);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .game-link a:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .embed-container {
      border-radius: 12px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const containers = document.querySelectorAll('.embed-container');

    containers.forEach(container => {
      const iframe = container.querySelector('iframe');
      const loading = container.querySelector<HTMLElement>('.loading-indicator');

      if (iframe && loading) {
        iframe.addEventListener('load', () => {
          loading.style.opacity = '0';
          loading.style.transition = 'opacity 0.3s';
          setTimeout(() => {
            loading.style.display = 'none';
          }, 300);
        });
      }
    });
  });
</script>
